#!/usr/bin/env node
/**
 * zstack thin control-plane CLI (zero external dependencies, Node >= 20 ESM).
 *
 * Commands:
 *   active
 *   board
 *   init-task <task-id> <project-slug> <title> [--priority P0|P1|P2] [--phase <phase>] [--kind feature|bug|release|review] [--severity P0|P1|P2|P3] [--owner me|team] [--bucket must|maybe|team] [--source <text>] [--depends-on <id,id>] [--has-migration] [--release-id <id>] [--lease-minutes <n>] [--pr <url>] [--next|--next-step <text>]
 *   set-phase <task-id> <phase> [--next|--next-step <text>] [--pr <url>] [--priority P0|P1|P2] [--kind <kind>] [--severity <sev>] [--owner <owner>] [--bucket <bucket>] [--depends-on <id,id>] [--has-migration]
 *   bind-thread <task-id> <role> <thread-id> [provider] [model] [note] (named flags also supported)
 *   archive-task <task-id> [reason]
 *   next-request-id <task-id> <step> <key>
 *   append-event <task-id> <type> [json-payload]
 *   check-receipt <task-id> <receipt-path> [--pinned-sha <sha>] [--role <role>]
 *   merge-gate <task-id>
 *   check-secrets [paths...]
 *   reindex
 *   serve [--port 4390] [--host 127.0.0.1]
 *   daemon <install|uninstall|status|restart|logs>
 *   sync-template [--dry-run] [--out <dir>] [--push] [--remote <url_or_name>]
 */

import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";
import {
  ALLOWED_BUCKETS,
  ALLOWED_KINDS,
  ALLOWED_OWNERS,
  ALLOWED_PHASES,
  ALLOWED_SEVERITIES,
  DEFAULT_LEASE_MINUTES,
  archiveTaskDirectory,
  defaultReleaseChecklist,
  detectMigration,
  getPrUrls,
  inferBucket,
  inferKind,
  inferOwner,
  inferSeverity,
  listActiveTaskStates,
  nowIso,
  rebuildBoard,
  todayStr,
} from "./board-core.mjs";

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const ROOT = path.resolve(__dirname, "..");

function fail(msg) {
  console.error(`[zstack] ERROR: ${msg}`);
  process.exit(1);
}

function taskDir(taskId) {
  return path.join(ROOT, "tasks", "active", taskId);
}

function readTaskState(taskId) {
  const statePath = path.join(taskDir(taskId), "state.json");
  if (!fs.existsSync(statePath)) {
    fail(`Active task "${taskId}" not found at ${statePath}`);
  }
  return { statePath, state: JSON.parse(fs.readFileSync(statePath, "utf8")) };
}

function writeTaskState(statePath, state) {
  state.updated_at = nowIso();
  fs.writeFileSync(statePath, JSON.stringify(state, null, 2) + "\n", "utf8");
}

function appendEventRecord(taskId, type, extra = {}) {
  const eventsPath = path.join(taskDir(taskId), "events.jsonl");
  const entry = { ts: nowIso(), type, ...extra };
  fs.appendFileSync(eventsPath, JSON.stringify(entry) + "\n", "utf8");
  return entry;
}

function readProjectMergePolicy(slug) {
  const projectFile = path.join(ROOT, "projects", slug, "project.yaml");
  if (!fs.existsSync(projectFile)) {
    fail(`Project "${slug}" not registered at ${projectFile}`);
  }
  const text = fs.readFileSync(projectFile, "utf8");
  const mergeBlock = text.match(/merge:\s*\n([\s\S]*?)(?:\n\s{2}\w+:|\n\w+:|$)/);
  const policyMatch = mergeBlock?.[1]?.match(/policy:\s*["']?([^"'\n#]+)["']?/);
  return {
    projectFile,
    mergePolicy: policyMatch ? policyMatch[1].trim() : "human_approval_required",
  };
}

function cmdActive() {
  const rows = listActiveTaskStates(ROOT).map((s) => {
    const kind = inferKind(s);
    return {
      task_id: s.task_id,
      project_slug: s.project_slug,
      kind,
      priority: s.priority || null,
      severity: inferSeverity(s, kind),
      owner: inferOwner(s),
      bucket: s.phase === "backlog" ? inferBucket(s) : s.bucket || null,
      phase: s.phase,
      title: s.title,
      pr_url: s.pull_request?.url || null,
      pull_requests: s.pull_requests || [],
      head_sha: s.pull_request?.head_sha || null,
      depends_on: Array.isArray(s.depends_on) ? s.depends_on : [],
      has_migration: detectMigration(s),
      next_step: s.next_step || null,
      updated_at: s.updated_at,
    };
  });
  console.log(JSON.stringify(rows, null, 2));
}

function cmdBoard() {
  const res = rebuildBoard(ROOT);
  console.log(
    JSON.stringify(
      {
        ok: true,
        board: path.relative(ROOT, res.boardPath),
        backlog: path.relative(ROOT, res.backlogPath),
        active: res.active,
        backlog_count: res.backlog,
        archived: res.archived,
      },
      null,
      2
    )
  );
}

function parseTaskFlags(rawArgs) {
  const positional = [];
  const opts = { prs: [], dependsOn: [] };
  const requireVal = (flag, idx) => {
    if (idx >= rawArgs.length) {
      fail(`Missing value for flag "${flag}"`);
    }
    return rawArgs[idx];
  };
  for (let i = 0; i < rawArgs.length; i++) {
    const a = rawArgs[i];
    if (a === "--") {
      positional.push(...rawArgs.slice(i + 1));
      break;
    }
    if (a === "--priority") opts.priority = requireVal(a, ++i);
    else if (a === "--phase") opts.phase = requireVal(a, ++i);
    else if (a === "--kind") opts.kind = requireVal(a, ++i);
    else if (a === "--severity") opts.severity = requireVal(a, ++i);
    else if (a === "--owner") opts.owner = requireVal(a, ++i);
    else if (a === "--bucket") opts.bucket = requireVal(a, ++i);
    else if (a === "--source") opts.source = requireVal(a, ++i);
    else if (a === "--release-id") opts.releaseId = requireVal(a, ++i);
    else if (a === "--lease-minutes") opts.leaseMinutes = Number(requireVal(a, ++i));
    else if (a === "--depends-on") {
      const val = requireVal(a, ++i);
      const parts = val.split(",").map((x) => x.trim()).filter(Boolean);
      opts.dependsOn.push(...parts);
    } else if (a === "--has-migration") {
      const next = rawArgs[i + 1];
      if (next === "true" || next === "false") {
        opts.hasMigration = next === "true";
        i++;
      } else {
        opts.hasMigration = true;
      }
    } else if (a === "--next" || a === "--next-step") opts.next = requireVal(a, ++i);
    else if (a === "--pr") opts.prs.push(requireVal(a, ++i));
    else if (a.startsWith("--")) {
      fail(
        `Unknown flag "${a}". Allowed: --priority | --phase | --kind | --severity | --owner | --bucket | --source | --depends-on | --has-migration | --release-id | --lease-minutes | --next | --next-step | --pr`
      );
    } else {
      positional.push(a);
    }
  }
  return { positional, opts };
}

function validateTaskOpts(opts) {
  if (opts.kind !== undefined && !ALLOWED_KINDS.has(opts.kind)) {
    fail(`Invalid --kind "${opts.kind}". Allowed: feature | bug | release | review`);
  }
  if (opts.severity !== undefined && !ALLOWED_SEVERITIES.has(opts.severity)) {
    fail(`Invalid --severity "${opts.severity}". Allowed: P0 | P1 | P2 | P3`);
  }
  if (opts.owner !== undefined && !ALLOWED_OWNERS.has(opts.owner)) {
    fail(`Invalid --owner "${opts.owner}". Allowed: me | team`);
  }
  if (opts.bucket !== undefined && !ALLOWED_BUCKETS.has(opts.bucket)) {
    fail(`Invalid --bucket "${opts.bucket}". Allowed: must | maybe | team`);
  }
  if (opts.phase !== undefined && !ALLOWED_PHASES.has(opts.phase)) {
    fail(`Invalid --phase "${opts.phase}". Allowed: ${[...ALLOWED_PHASES].join(" | ")}`);
  }
  if (opts.leaseMinutes !== undefined && (!Number.isFinite(opts.leaseMinutes) || opts.leaseMinutes <= 0)) {
    fail(`Invalid --lease-minutes "${opts.leaseMinutes}". Expected positive number.`);
  }
}

function cmdInitTask(args) {
  const { positional, opts } = parseTaskFlags(args);
  validateTaskOpts(opts);
  const [taskId, projectSlug, ...titleParts] = positional;
  const title = titleParts.join(" ").trim();
  if (!taskId || !projectSlug || !title) {
    fail(
      "Usage: zstack init-task <task-id> <project-slug> <title> [--priority P0|P1|P2] [--phase <phase>] [--kind feature|bug|release|review] [--severity P0|P1|P2|P3] [--owner me|team] [--bucket must|maybe|team] [--source <text>] [--depends-on <id,id>] [--has-migration] [--pr <url>] [--next|--next-step <text>]"
    );
  }
  if (!/^[a-z0-9][a-z0-9-_]{2,80}$/.test(taskId)) {
    fail(`Invalid task-id "${taskId}". Use lowercase letters, digits, '-' or '_'.`);
  }
  const { mergePolicy } = readProjectMergePolicy(projectSlug);
  const dir = taskDir(taskId);
  if (fs.existsSync(dir)) {
    fail(`Task directory already exists: ${dir}`);
  }
  fs.mkdirSync(path.join(dir, "receipts"), { recursive: true });

  const ts = nowIso();
  const kind = opts.kind || "feature";
  const phase = opts.phase || "intake";
  const severity = opts.severity || (kind === "bug" ? (ALLOWED_SEVERITIES.has(opts.priority) ? opts.priority : "P1") : null);
  const priority = opts.priority || (severity ? (severity === "P3" ? "P2" : severity) : "P1");
  const bucket = opts.bucket || (phase === "backlog" ? (opts.owner === "team" ? "team" : "must") : null);
  const owner = opts.owner || (bucket === "team" ? "team" : "me");

  const state = {
    schema_version: 1,
    task_id: taskId,
    project_slug: projectSlug,
    kind,
    title,
    priority,
    ...(severity ? { severity } : {}),
    owner,
    ...(bucket ? { bucket } : {}),
    ...(opts.source ? { source: opts.source } : {}),
    depends_on: [...new Set(opts.dependsOn)],
    ...(opts.hasMigration !== undefined ? { has_migration: opts.hasMigration } : {}),
    release_id: opts.releaseId || null,
    ...(kind === "release" ? { checklist: defaultReleaseChecklist(projectSlug) } : {}),
    lease_minutes: opts.leaseMinutes || DEFAULT_LEASE_MINUTES,
    phase,
    next_step: opts.next || null,
    created_at: ts,
    updated_at: ts,
    threads: {
      implementer: null,
      reviewers: [],
      investigators: [],
      merger: null,
    },
    pull_request: opts.prs.length === 1 ? { url: opts.prs[0], head_sha: null } : null,
    pull_requests: opts.prs,
    gates: {
      independent_review_pass: {
        satisfied: false,
        verified_head_sha: null,
        reviewer_thread_id: null,
        receipt_path: null,
      },
      merge_authorization: {
        policy: mergePolicy,
        approved: false,
        approved_by: null,
        approved_head_sha: null,
        approved_at: null,
      },
      deploy_authorization: {
        policy: "forbidden_by_default",
        requested: false,
        approved: false,
      },
    },
    idempotency_keys: {},
    open_risks: [],
  };

  fs.writeFileSync(path.join(dir, "state.json"), JSON.stringify(state, null, 2) + "\n", "utf8");
  appendEventRecord(taskId, "task_initialized", {
    project_slug: projectSlug,
    kind,
    title,
    priority: state.priority,
    ...(severity ? { severity } : {}),
    owner,
    ...(bucket ? { bucket } : {}),
    phase: state.phase,
    merge_policy: mergePolicy,
  });
  rebuildBoard(ROOT);
  console.log(JSON.stringify({ ok: true, task_id: taskId, path: path.join(dir, "state.json") }, null, 2));
}

function cmdSetPhase(args) {
  const { positional, opts } = parseTaskFlags(args);
  const [taskId, phase] = positional;
  if (!taskId || !phase) {
    fail("Usage: zstack set-phase <task-id> <phase> [--next|--next-step <text>] [--pr <url>] [--priority P0|P1|P2]");
  }
  if (!ALLOWED_PHASES.has(phase)) {
    fail(`Invalid phase "${phase}". Allowed: ${[...ALLOWED_PHASES].join(" | ")}`);
  }
  validateTaskOpts(opts);
  const { statePath, state } = readTaskState(taskId);
  const prevPhase = state.phase;
  state.phase = phase;
  if (opts.next !== undefined) state.next_step = opts.next;
  if (opts.priority !== undefined) state.priority = opts.priority;
  if (opts.kind !== undefined) state.kind = opts.kind;
  if (opts.severity !== undefined) state.severity = opts.severity;
  if (opts.owner !== undefined) state.owner = opts.owner;
  if (opts.bucket !== undefined) state.bucket = opts.bucket;
  if (opts.source !== undefined) state.source = opts.source;
  if (opts.releaseId !== undefined) state.release_id = opts.releaseId;
  if (opts.hasMigration !== undefined) state.has_migration = opts.hasMigration;
  if (opts.leaseMinutes !== undefined) state.lease_minutes = opts.leaseMinutes;
  if (opts.dependsOn.length > 0) {
    state.depends_on = [...new Set(opts.dependsOn)];
  }
  if (opts.prs.length > 0) {
    const existing = Array.isArray(state.pull_requests) ? state.pull_requests : [];
    state.pull_requests = [...new Set([...existing, ...opts.prs])];
    if (!state.pull_request && state.pull_requests.length === 1) {
      state.pull_request = { url: state.pull_requests[0], head_sha: null };
    }
  }
  writeTaskState(statePath, state);
  appendEventRecord(taskId, "phase_updated", { from: prevPhase, to: phase, next_step: state.next_step });
  rebuildBoard(ROOT);
  console.log(JSON.stringify({ ok: true, task_id: taskId, from: prevPhase, to: phase }, null, 2));
}

function cmdBindThread(args) {
  const positional = [];
  const opts = {};
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    if (a === "--provider") opts.provider = args[++i];
    else if (a === "--model") opts.model = args[++i];
    else if (a === "--note") opts.note = args[++i];
    else positional.push(a);
  }
  const [taskId, role, threadId, provider, model, note] = positional;
  const usage = "Usage: zstack bind-thread <task-id> <role> <thread-id> [provider] [model] [note] (or use --provider, --model, --note)";
  if (!taskId || !role || !threadId || positional.length > 6) {
    fail(usage);
  }
  opts.provider ??= provider;
  opts.model ??= model;
  opts.note ??= note;
  const allowedRoles = new Set(["implementer", "reviewer", "investigator", "merger"]);
  if (!allowedRoles.has(role)) {
    fail(`Invalid role "${role}". Allowed: implementer | reviewer | investigator | merger`);
  }

  const { statePath, state } = readTaskState(taskId);
  if (!state.threads || typeof state.threads !== "object") {
    state.threads = { implementer: null, reviewers: [], investigators: [], merger: null };
  }

  const ts = nowIso();
  const buildRecord = (existing) => {
    const base = existing && existing.thread_id === threadId ? { ...existing } : {};
    base.thread_id = threadId;
    if (opts.provider !== undefined) base.provider = opts.provider;
    if (opts.model !== undefined) base.model = opts.model;
    if (opts.note !== undefined) base.note = opts.note;
    base.bound_at = ts;
    return base;
  };

  let record;
  let updatedExisting = false;
  if (role === "implementer" || role === "merger") {
    updatedExisting = Boolean(state.threads[role] && state.threads[role].thread_id === threadId);
    record = buildRecord(state.threads[role]);
    state.threads[role] = record;
  } else {
    const listKey = role === "reviewer" ? "reviewers" : "investigators";
    if (!Array.isArray(state.threads[listKey])) state.threads[listKey] = [];
    const idx = state.threads[listKey].findIndex((item) => item && item.thread_id === threadId);
    if (idx >= 0) {
      updatedExisting = true;
      record = buildRecord(state.threads[listKey][idx]);
      state.threads[listKey][idx] = record;
    } else {
      record = buildRecord(null);
      state.threads[listKey].push(record);
    }
  }

  writeTaskState(statePath, state);
  const eventPayload = { role, thread_id: threadId };
  if (opts.provider !== undefined) eventPayload.provider = opts.provider;
  if (opts.model !== undefined) eventPayload.model = opts.model;
  if (opts.note !== undefined) eventPayload.note = opts.note;
  appendEventRecord(taskId, "thread_bound", eventPayload);
  rebuildBoard(ROOT);
  console.log(JSON.stringify({ ok: true, task_id: taskId, role, thread_id: threadId, updated_existing: updatedExisting, record }, null, 2));
}

function cmdArchiveTask(args) {
  const [taskId, ...reasonParts] = args;
  const reason = reasonParts.join(" ").trim() || "completed";
  if (!taskId) {
    fail("Usage: zstack archive-task <task-id> [reason]");
  }
  const result = archiveTaskDirectory(ROOT, taskId, reason);
  rebuildBoard(ROOT);
  console.log(JSON.stringify({ ok: true, ...result }, null, 2));
}

function cmdNextRequestId(args) {
  const [taskId, step, key] = args;
  if (!taskId || !step || !key) {
    fail("Usage: zstack next-request-id <task-id> <step> <key>");
  }
  const { statePath, state } = readTaskState(taskId);
  const lookupKey = `${step}:${key}`;
  if (state.idempotency_keys[lookupKey]) {
    console.log(
      JSON.stringify({
        client_request_id: state.idempotency_keys[lookupKey],
        reused: true,
      })
    );
    return;
  }
  const reqId = `${taskId}:${step}:${key}:1`;
  state.idempotency_keys[lookupKey] = reqId;
  writeTaskState(statePath, state);
  appendEventRecord(taskId, "idempotency_key_issued", { lookup_key: lookupKey, client_request_id: reqId });
  console.log(JSON.stringify({ client_request_id: reqId, reused: false }));
}

function cmdAppendEvent(args) {
  const [taskId, type, payloadStr] = args;
  if (!taskId || !type) {
    fail("Usage: zstack append-event <task-id> <type> [json-payload]");
  }
  readTaskState(taskId);
  let extra = {};
  if (payloadStr) {
    try {
      extra = JSON.parse(payloadStr);
    } catch {
      fail("Invalid JSON payload for append-event");
    }
  }
  const entry = appendEventRecord(taskId, type, extra);
  console.log(JSON.stringify(entry));
}

function cmdCheckReceipt(args) {
  const taskId = args[0];
  const receiptPath = args[1];
  if (!taskId || !receiptPath) {
    fail("Usage: zstack check-receipt <task-id> <receipt-path> [--pinned-sha <sha>] [--role <role>]");
  }
  let pinnedSha = null;
  let expectedRole = null;
  for (let i = 2; i < args.length; i++) {
    if (args[i] === "--pinned-sha") pinnedSha = args[++i];
    else if (args[i] === "--role") expectedRole = args[++i];
  }

  const { statePath, state } = readTaskState(taskId);
  const absReceipt = path.isAbsolute(receiptPath) ? receiptPath : path.resolve(ROOT, receiptPath);
  if (!fs.existsSync(absReceipt)) fail(`Receipt file not found: ${absReceipt}`);

  let receipt;
  try {
    receipt = JSON.parse(fs.readFileSync(absReceipt, "utf8"));
  } catch (e) {
    fail(`Invalid JSON in receipt: ${e.message}`);
  }

  const errors = [];
  const requiredTop = [
    "contract_version",
    "task_id",
    "step_id",
    "role",
    "status",
    "git_evidence",
    "checks",
    "findings",
    "open_risks",
    "next_recommendation",
  ];
  for (const field of requiredTop) {
    if (!(field in receipt)) errors.push(`Missing required field: ${field}`);
  }

  if (receipt.contract_version !== "1.0") errors.push(`Expected contract_version "1.0", got "${receipt.contract_version}"`);
  if (receipt.task_id !== taskId) errors.push(`Receipt task_id "${receipt.task_id}" does not match "${taskId}"`);
  if (expectedRole && receipt.role !== expectedRole) {
    errors.push(`Receipt role "${receipt.role}" does not match expected "${expectedRole}"`);
  }

  const ge = receipt.git_evidence || {};
  if (!ge.head_sha || typeof ge.head_sha !== "string") errors.push("Missing git_evidence.head_sha");
  if (!ge.base_sha || typeof ge.base_sha !== "string") errors.push("Missing git_evidence.base_sha");
  if (pinnedSha && ge.head_sha !== pinnedSha) {
    errors.push(`Stale/mismatched SHA: receipt head_sha "${ge.head_sha}" !== pinned_sha "${pinnedSha}"`);
  }

  if (receipt.role === "reviewer") {
    if (ge.working_tree_clean !== true) {
      errors.push("Reviewer receipt must confirm git_evidence.working_tree_clean === true");
    }
  }

  if (receipt.role === "investigator") {
    const ee = receipt.environment_evidence;
    if (!ee || ee.read_only_confirmed !== true || ee.mutations_performed !== 0) {
      errors.push("Investigator receipt must confirm environment_evidence.read_only_confirmed === true and mutations_performed === 0");
    }
  }

  if (receipt.status === "pass") {
    const blockingFindings = (receipt.findings || []).filter(
      (f) => f.status === "open" && (f.severity === "blocker" || f.severity === "major")
    );
    if (blockingFindings.length > 0) {
      errors.push(`Status is "pass" but ${blockingFindings.length} open blocker/major findings exist`);
    }
    const failedChecks = (receipt.checks || []).filter((c) => c.result === "fail" || (typeof c.failed === "number" && c.failed > 0));
    if (failedChecks.length > 0) {
      errors.push(`Status is "pass" but ${failedChecks.length} checks failed`);
    }
  }

  if (errors.length > 0) {
    console.log(JSON.stringify({ ok: false, errors }, null, 2));
    process.exit(1);
  }
  const prUrls = getPrUrls(state);
  const prUrl = state.pull_request?.url || (prUrls.length === 1 ? prUrls[0] : null)
    || (prUrls.length === 0 ? ge.pr_url : null);
  if (prUrl && (!ge.pr_url || ge.pr_url === prUrl) && state.pull_request?.head_sha !== ge.head_sha) {
    state.pull_request = { ...state.pull_request, url: prUrl, head_sha: ge.head_sha };
    writeTaskState(statePath, state);
  }
  console.log(JSON.stringify({ ok: true, task_id: taskId, role: receipt.role, status: receipt.status, head_sha: ge.head_sha }, null, 2));
}

function cmdMergeGate(args) {
  const [taskId] = args;
  if (!taskId) fail("Usage: zstack merge-gate <task-id>");

  const { state } = readTaskState(taskId);
  const { mergePolicy } = readProjectMergePolicy(state.project_slug);
  const errors = [];

  const pr = state.pull_request;
  if (!pr || !pr.url || !pr.head_sha) {
    errors.push("Missing pull_request.url or pull_request.head_sha in state.json");
  }

  const revGate = state.gates?.independent_review_pass;
  if (!revGate || revGate.satisfied !== true) {
    errors.push("Independent review gate is not satisfied");
  } else {
    if (pr && revGate.verified_head_sha !== pr.head_sha) {
      errors.push(`Reviewed SHA (${revGate.verified_head_sha}) !== current PR head_sha (${pr.head_sha})`);
    }
    const implThreadId = state.threads?.implementer?.thread_id;
    if (!revGate.reviewer_thread_id) {
      errors.push("Missing reviewer_thread_id on independent_review_pass gate");
    } else if (implThreadId && revGate.reviewer_thread_id === implThreadId) {
      errors.push("Role separation violation: reviewer_thread_id equals implementer.thread_id");
    }
    if (!revGate.receipt_path) {
      errors.push("Missing receipt_path on independent_review_pass gate");
    } else {
      const absReceipt = path.resolve(ROOT, revGate.receipt_path);
      if (!fs.existsSync(absReceipt)) {
        errors.push(`Referenced review receipt not found: ${revGate.receipt_path}`);
      } else {
        const receipt = JSON.parse(fs.readFileSync(absReceipt, "utf8"));
        if (receipt.status !== "pass") errors.push(`Review receipt status is "${receipt.status}", expected "pass"`);
        if (receipt.role !== "reviewer") errors.push(`Review receipt role is "${receipt.role}", expected "reviewer"`);
        if (pr && receipt.git_evidence?.head_sha !== pr.head_sha) {
          errors.push(`Review receipt head_sha (${receipt.git_evidence?.head_sha}) !== PR head_sha (${pr.head_sha})`);
        }
        const openBlocking = (receipt.findings || []).filter(
          (f) => f.status === "open" && (f.severity === "blocker" || f.severity === "major")
        );
        if (openBlocking.length > 0) errors.push(`Review receipt still has ${openBlocking.length} open blocker/major findings`);
      }
    }
  }

  const mergeAuth = state.gates?.merge_authorization || {};
  if (mergePolicy === "human_approval_required") {
    if (mergeAuth.approved !== true || (pr && mergeAuth.approved_head_sha !== pr.head_sha)) {
      errors.push("Project policy requires explicit human merge approval for current head_sha");
    }
  } else if (mergePolicy !== "auto_merge_on_gate_pass") {
    errors.push(`Unsupported merge policy "${mergePolicy}"`);
  }

  if (errors.length > 0) {
    console.log(JSON.stringify({ eligible: false, policy: mergePolicy, errors }, null, 2));
    process.exit(1);
  }
  console.log(
    JSON.stringify(
      {
        eligible: true,
        policy: mergePolicy,
        task_id: taskId,
        pr_url: pr.url,
        approved_head_sha: pr.head_sha,
        reviewer_thread_id: revGate.reviewer_thread_id,
      },
      null,
      2
    )
  );
}

const SECRET_RULES = [
  { name: "GitHub PAT", re: /\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{20,}\b/g },
  { name: "GitHub Fine-Grained PAT", re: /\bgithub_pat_[A-Za-z0-9_]{20,}\b/g },
  { name: "OpenAI / Anthropic API Key", re: /\bsk-(?:proj-|ant-)?[A-Za-z0-9_-]{20,}\b/g },
  { name: "AWS Access Key", re: /\bAKIA[0-9A-Z]{16}\b/g },
  { name: "Private Key Block", re: /-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----/g },
  { name: "Bearer Token", re: /\bBearer\s+[A-Za-z0-9._-]{24,}\b/g },
  { name: "Mainland China Mobile PII", re: /(?:(?<![0-9A-Za-z])|(?<=\+86))1[3-9]\d{9}(?![0-9A-Za-z])/g },
  { name: "DB / Cache Credential URL", re: /\b(?:postgres(?:ql)?|mysql|mariadb|mongodb(?:\+srv)?|rediss?|amqps?):\/\/(?!<)[^/\s:@"'`<>]+:(?!<|\*|\$\{)[^/\s@"'`<>]{4,}@[^\s"'`<>]+/gi },
  { name: "S3 / OSS Presigned URL Signature", re: /[?&](?:X-Amz-Signature|X-Amz-Credential|X-Amz-Security-Token|OSSAccessKeyId|Signature)=[A-Za-z0-9%_+/=-]{12,}/gi },
  { name: "Webhook / API Secret Query URL", re: /https?:\/\/[^\s"'`<>]+\?(?:[^\s"'`<>]*&)?(?:token|key|secret|api_key|apikey|access_token|webhook_secret)=(?!<|\*|\$\{)[A-Za-z0-9._~%+/=-]{8,}/gi },
];

function walkFiles(dir, out = []) {
  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
    if ([".git", ".zstack-cache", "node_modules"].includes(entry.name)) continue;
    const full = path.join(dir, entry.name);
    if (entry.isSymbolicLink()) continue;
    if (entry.isDirectory()) walkFiles(full, out);
    else out.push(full);
  }
  return out;
}

function cmdCheckSecrets(args) {
  const targets = [];
  if (args.length > 0) {
    for (const p of args) {
      const abs = path.isAbsolute(p) ? p : path.resolve(ROOT, p);
      if (!fs.existsSync(abs)) continue;
      if (fs.statSync(abs).isDirectory()) walkFiles(abs, targets);
      else targets.push(abs);
    }
  } else {
    walkFiles(ROOT, targets);
  }

  const hits = [];
  for (const file of targets) {
    if (!fs.existsSync(file) || fs.statSync(file).isDirectory()) continue;
    const rel = path.relative(ROOT, file);
    if (rel === "scripts/zstack") continue; // skip scanner regex definitions itself
    const content = fs.readFileSync(file, "utf8");
    const lines = content.split("\n");
    for (let i = 0; i < lines.length; i++) {
      for (const rule of SECRET_RULES) {
        rule.re.lastIndex = 0;
        if (rule.re.test(lines[i])) {
          hits.push({ file: rel.startsWith("..") ? file : rel, line: i + 1, rule: rule.name });
        }
      }
    }
  }

  if (hits.length > 0) {
    console.log(JSON.stringify({ ok: false, hits }, null, 2));
    process.exit(1);
  }
  console.log(JSON.stringify({ ok: true, scanned_files: targets.length, hits: [] }, null, 2));
}

function parseMemoryFile(filePath) {
  const rel = path.relative(ROOT, filePath);
  const text = fs.readFileSync(filePath, "utf8");
  const blocks = [...text.matchAll(/```yaml\n([\s\S]*?)```/g)];
  const entries = [];
  const todayMs = Date.parse(todayStr());

  for (const match of blocks) {
    const raw = match[1];
    const get = (k) => {
      const m = raw.match(new RegExp(`^${k}:\\s*(.+)$`, "m"));
      return m ? m[1].trim().replace(/^["']|["']$/g, "") : null;
    };
    const id = get("id");
    if (!id) continue;
    const verifiedAt = get("verified_at");
    const ttlDays = Number(get("ttl_days") || 90);
    let status = get("status") || "active";
    if (status === "active" && verifiedAt) {
      const ageDays = Math.floor((todayMs - Date.parse(verifiedAt)) / 86400000);
      if (ageDays > ttlDays) status = "stale";
    }
    entries.push({
      id,
      scope: get("scope") || "global",
      kind: get("kind") || "fact",
      confidence: get("confidence") || "observed",
      status,
      verified_at: verifiedAt || "-",
      summary: get("summary") || "",
      file: rel,
    });
  }
  return entries;
}

function cmdReindex() {
  const memDir = path.join(ROOT, "memory");
  const files = [];
  const pref = path.join(memDir, "preferences.md");
  if (fs.existsSync(pref)) files.push(pref);
  const factsDir = path.join(memDir, "facts");
  if (fs.existsSync(factsDir)) {
    for (const f of fs.readdirSync(factsDir).sort()) {
      if (f.endsWith(".md")) files.push(path.join(factsDir, f));
    }
  }

  const all = files.flatMap(parseMemoryFile);
  const lines = [
    "# Memory Index (Auto-generated by `./scripts/zstack reindex`)",
    "",
    `Last rebuilt: ${todayStr()} · Total entries: ${all.length}`,
    "",
    "| ID | Scope | Kind | Confidence | Status | Verified | Summary | Source File |",
    "|---|---|---|---|---|---|---|---|",
  ];
  for (const e of all) {
    lines.push(
      `| \`${e.id}\` | \`${e.scope}\` | ${e.kind} | ${e.confidence} | \`${e.status}\` | ${e.verified_at} | ${e.summary.replace(/\|/g, "\\|")} | \`${e.file}\` |`
    );
  }
  lines.push("");

  const indexPath = path.join(memDir, "INDEX.md");
  fs.writeFileSync(indexPath, lines.join("\n"), "utf8");
  console.log(JSON.stringify({ ok: true, index: path.relative(ROOT, indexPath), count: all.length }, null, 2));
}

const [cmd, ...rest] = process.argv.slice(2);
switch (cmd) {
  case "active":
    cmdActive();
    break;
  case "board":
    cmdBoard();
    break;
  case "init-task":
    cmdInitTask(rest);
    break;
  case "set-phase":
    cmdSetPhase(rest);
    break;
  case "bind-thread":
    cmdBindThread(rest);
    break;
  case "archive-task":
    cmdArchiveTask(rest);
    break;
  case "next-request-id":
    cmdNextRequestId(rest);
    break;
  case "append-event":
    cmdAppendEvent(rest);
    break;
  case "check-receipt":
    cmdCheckReceipt(rest);
    break;
  case "merge-gate":
    cmdMergeGate(rest);
    break;
  case "check-secrets":
    cmdCheckSecrets(rest);
    break;
  case "reindex":
    cmdReindex();
    break;
  case "serve": {
    const { startDashboardServer } = await import("./dashboard-server.mjs");
    let port = Number(process.env.ZSTACK_BOARD_PORT || 4390);
    let host = "127.0.0.1";
    for (let i = 0; i < rest.length; i++) {
      if (rest[i] === "--port") port = Number(rest[++i]);
      else if (rest[i] === "--host") host = rest[++i];
    }
    startDashboardServer({ root: ROOT, host, port });
    break;
  }
  case "daemon": {
    const { runDaemon } = await import("./daemon.mjs");
    try {
      await runDaemon(rest, ROOT);
    } catch (error) {
      fail(error.message);
    }
    break;
  }
  case "sync-template": {
    const { runSyncTemplate } = await import("./sync-template.mjs");
    await runSyncTemplate(rest, { root: ROOT, secretRules: SECRET_RULES });
    break;
  }
  default:
    fail("Unknown command. Available: active | board | init-task | set-phase | bind-thread | archive-task | next-request-id | append-event | check-receipt | merge-gate | check-secrets | reindex | serve | daemon | sync-template");
}
