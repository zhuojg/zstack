{
  "zstack-orchestrator-guard": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./hooks/session-start.mjs",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command|write_file|edit_file|read_file|view_file|write_to_file|replace_file_content|multi_replace_file_content|grep_search|find_by_name|list_dir",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/orchestrator-guard.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
